@model IEnumerable<DoAnQuanLyKhachSan.Models.Room>

@{
    ViewBag.Title = "Quản lý phòng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Quản lý phòng</h2>
        <div>
            <a href="@Url.Action("TrangChu", "Home")" class="btn btn-secondary me-2">← Quay lại</a>
            <a href="@Url.Action("Create", "Rooms")" class="btn btn-primary">➕ Thêm phòng</a>
        </div>
    </div>

    <table class="table table-bordered table-hover table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Mã phòng</th>
                <th>Kiếu phòng</th>
                <th>Trạng thái</th>
                <th>Tầng</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RoomNumber</td>
                    <td>@item.RoomType</td>
                    <td>@item.Status</td>
                    <td>@item.Floor.FloorName</td>

                    <td class="text-center">
                        <a href="@Url.Action("Edit", "Rooms", new { id = item.RoomId })" class="btn btn-sm btn-warning me-1">✏️ Sửa</a>
                        <a href="@Url.Action("Details", "Rooms", new { id = item.RoomId })" class="btn btn-sm btn-info me-1">🔍 Chi tiết</a>
                        <a href="@Url.Action("Delete", "Rooms", new { id = item.RoomId })" class="btn btn-sm btn-danger">🗑️ Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


