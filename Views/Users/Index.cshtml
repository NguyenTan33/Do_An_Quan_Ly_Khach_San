
@model IEnumerable<DoAnQuanLyKhachSan.Models.User>
@{
    ViewBag.Title = "Quản lý tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Quản lý người dùng </h2>
        <div>
            <a href="@Url.Action("TrangChu", "Home")" class="btn btn-secondary me-2">← Quay lại</a>
            <a href="@Url.Action("Create", "Users")" class="btn btn-primary">➕ Thêm tài khoản</a>
        </div>
    </div>

    <table class="table table-bordered table-hover table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Tên đăng nhập</th>
                <th>Mật khẩu</th>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Vai trò</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Username</td>
                    <td>@item.PasswordHash</td>
                    <td>@item.FullName</td>
                    <td>@item.Email</td>
                    <td>@item.Role.RoleName</td>
                    <td class="text-center">
                        <a href="@Url.Action("Edit", "Users", new { id = item.UserId })" class="btn btn-sm btn-warning me-1">✏️ Sửa</a>
                        <a href="@Url.Action("Details", "Users", new { id = item.UserId })" class="btn btn-sm btn-info me-1">🔍 Chi tiết</a>
                        <a href="@Url.Action("Delete", "Users", new { id = item.UserId })" class="btn btn-sm btn-danger">🗑️ Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
