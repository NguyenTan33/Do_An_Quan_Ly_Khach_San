@model IEnumerable<DoAnQuanLyKhachSan.Models.Staff>

@{
    ViewBag.Title = "Quản lý nhân viên";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Quản lý nhân viên</h2>
        <div>
            <a href="@Url.Action("TrangChu", "Home")" class="btn btn-secondary me-2">← Quay lại</a>
            <a href="@Url.Action("Create", "Staffs")" class="btn btn-primary">➕ Thêm nhân viên</a>
        </div>
    </div>

    <table class="table table-bordered table-hover table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Số điện thoại</th>
                <th>Địa chỉ</th>
                <th>Giới tính</th>
                <th>Ngày sinh</th>
                <th>Họ và tên</th>
                <th>Vai trò</th>
                <th class="text-center">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                    <td>@item.Gender</td>
                    <td>@item.BirthDate</td>
                    <td>@item.User.FullName</td>
                    <td>@item.User.Role.RoleName</td>
                    <td class="text-center">
                        <a href="@Url.Action("Edit", "Staffs", new { id = item.StaffId })" class="btn btn-sm btn-warning me-1">✏️ Sửa</a>
                        <a href="@Url.Action("Details", "Staffs", new { id = item.StaffId })" class="btn btn-sm btn-info me-1">🔍 Chi tiết</a>
                        <a href="@Url.Action("Delete", "Staffs", new { id = item.StaffId })" class="btn btn-sm btn-danger">🗑️ Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

